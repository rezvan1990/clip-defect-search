# Copy to .env if you want docker compose to pick these up.
# None of these are required for /health or for scoring without alerts.

# Optional. Cosine-gap cutoff. Not calibrated. Unset means decisions stay "unscored".
ALERT_SCORE_THRESHOLD=

# Optional channels. The JSONL + SQLite log is always written for a defect.
DEFECT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=qc@localhost
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_STARTTLS=
